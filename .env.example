# use this file for configuring the frontend, clone this and rename it to .env

# install the site with:
#   envsubst '${LISTEN_PORT} ${BACKEND_URL}' < nginx/exoticpets.conf.template > /etc/nginx/conf.d/exoticpets.conf
LISTEN_PORT=4187 # do not change lol
BACKEND_URL=http://10.10.20.10:4193 # default for proxmox server, change IP for your testing environment
